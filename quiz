                            <span class="q-tag">(${q.tag})</span>
                        </div>
                        <div class="q-body">${q.text}</div>
                        <div class="options-grid">
                            ${renderOptionBox(q, 'a', 'أ', selected)}
                            ${renderOptionBox(q, 'b', 'ب', selected)}
                            ${renderOptionBox(q, 'c', 'ج', selected)}
                            ${renderOptionBox(q, 'd', 'د', selected)}
                        </div>
                        <div class="q-explanation" id="exp_${q.standard}_${q.id}">
                            💡 <strong>مفتاح الحل والخطوات:</strong> ${q.explanation}
                        </div>
                    `;
                    container.appendChild(card);

                    if (currentMode === 'practice' && selected) {
                        revealExplanation(q, selected === q.correct);
                    }
                });
            }

            renderAnswerKeyBar(pageQuestions);

            document.getElementById('pageIndicator').innerText = `الصفحة ${page} من ${totalPages}`;
            document.getElementById('pageNumLabel').innerText = `صفحة ${page}`;
            document.getElementById('footerPageNumber').innerText = `${page} صفحة | ${standardsMeta[activeStandard].title}`;
            document.getElementById('prevPageBtn').disabled = (page === 1);
            document.getElementById('nextPageBtn').disabled = (page === totalPages || totalPages === 0);

            renderKaTeX();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderOptionBox(q, optKey, optLetter, selected) {
            let extraClass = '';
            if (selected === optKey) {
                if (currentMode === 'practice') {
                    extraClass = (optKey === q.correct) ? 'correct' : 'wrong';
                } else {
                    extraClass = 'selected';
                }
            } else if (currentMode === 'practice' && selected && optKey === q.correct) {
                extraClass = 'correct';
            }

            return `
                <div class="option-box ${extraClass}" onclick="handleOptionClick('${q.standard}', ${q.id}, '${optKey}')" id="opt_${q.standard}_${q.id}_${optKey}">
                    <span class="opt-letter">${optLetter}</span>
                    <span class="opt-text">${q.options[optKey]}</span>
                </div>
            `;
        }

        function handleOptionClick(std, qId, selectedKey) {
            const key = `${std}_${qId}`;
            if (currentMode === 'exam') {
                userAnswers[key] = selectedKey;
                ['a', 'b', 'c', 'd'].forEach(k => {
                    const el = document.getElementById(`opt_${std}_${qId}_${k}`);
                    if (el) el.className = `option-box ${k === selectedKey ? 'selected' : ''}`;
                });
                return;
            }

            if (userAnswers[key]) return;
            userAnswers[key] = selectedKey;
            const q = questionsData.find(item => item.standard === std && item.id === qId);
            const isCorrect = (selectedKey === q.correct);

            ['a', 'b', 'c', 'd'].forEach(k => {
                const el = document.getElementById(`opt_${std}_${qId}_${k}`);
                if (!el) return;
                if (k === q.correct) el.className = 'option-box correct';
                else if (k === selectedKey) el.className = 'option-box wrong';
            });

            revealExplanation(q, isCorrect);
        }

        function revealExplanation(q, isCorrect) {
            const expEl = document.getElementById(`exp_${q.standard}_${q.id}`);
            if (expEl) {
                expEl.style.display = 'block';
                expEl.style.borderRightColor = isCorrect ? 'var(--success-green)' : 'var(--danger-red)';
            }
        }

        function renderAnswerKeyBar(pageQuestions) {
            const container = document.getElementById('answerKeyItemsContainer');
            container.innerHTML = '';
            const letterMap = { a: 'أ', b: 'ب', c: 'ج', d: 'د' };

            pageQuestions.forEach(q => {
                const token = document.createElement('span');
                token.className = `key-token ${isKeyVisible ? '' : 'hidden-key'}`;
                token.innerText = `${q.id}: ${letterMap[q.correct]}`;
                container.appendChild(token);
            });
        }

        function togglePageKey() {
            isKeyVisible = !isKeyVisible;
            document.querySelectorAll('.key-token').forEach(tok => {
                if (isKeyVisible) tok.classList.remove('hidden-key');
                else tok.classList.add('hidden-key');
            });
        }

        function switchMode(mode) {
            currentMode = mode;
            userAnswers = {};
            document.getElementById('modePracticeBtn').className = `mode-btn ${mode === 'practice' ? 'active' : ''}`;
            document.getElementById('modeExamBtn').className = `mode-btn ${mode === 'exam' ? 'active' : ''}`;

            const finishBtn = document.getElementById('examFinishBtn');
            const timerBadge = document.getElementById('examTimerBadge');

            if (mode === 'exam') {
                finishBtn.style.display = 'inline-flex';
                timerBadge.style.display = 'inline-block';
                startExamTimer();
            } else {
                finishBtn.style.display = 'none';
                timerBadge.style.display = 'none';
                stopExamTimer();
            }

            renderPage(currentPage);
        }

        function startExamTimer() {
            timeLeft = 45 * 60;
            if (examTimer) clearInterval(examTimer);
            examTimer = setInterval(() => {
                timeLeft--;
                const min = Math.floor(timeLeft / 60);
                const sec = timeLeft % 60;
                document.getElementById('timerDisplay').innerText = 
                    `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
                if (timeLeft <= 0) {
                    clearInterval(examTimer);
                    finishExam();
                }
            }, 1000);
        }

        function stopExamTimer() {
            if (examTimer) clearInterval(examTimer);
        }

        function finishExam() {
            stopExamTimer();
            let score = 0;
            const total = filteredQuestions.length;

            filteredQuestions.forEach(q => {
                const key = `${q.standard}_${q.id}`;
                if (userAnswers[key] === q.correct) {
                    score++;
                }
            });

            const percent = total > 0 ? Math.round((score / total) * 100) : 0;
            document.getElementById('resScoreNum').innerText = score;
            document.getElementById('resTotalNum').innerText = total;
            document.getElementById('resPercentage').innerText = `النسبة المئوية: ${percent}%`;
            document.getElementById('resStandardTitle').innerText = standardsMeta[activeStandard].title;

            document.getElementById('resultModal').style.display = 'flex';
        }

        function closeResultModal() {
            document.getElementById('resultModal').style.display = 'none';
        }

        function reviewMistakes() {
            closeResultModal();
            currentMode = 'practice';
            document.getElementById('modePracticeBtn').className = 'mode-btn active';
            document.getElementById('modeExamBtn').className = 'mode-btn';
            document.getElementById('examFinishBtn').style.display = 'none';
            document.getElementById('examTimerBadge').style.display = 'none';
            renderPage(currentPage);
        }

        function nextPage() {
            if (currentPage < totalPages) renderPage(currentPage + 1);
        }

        function prevPage() {
            if (currentPage > 1) renderPage(currentPage - 1);
        }

        function openIndexModal() {
            document.getElementById('indexModal').style.display = 'flex';
        }

        function closeIndexModal() {
            document.getElementById('indexModal').style.display = 'none';
        }

        function renderKaTeX() {
            if (window.renderMathInElement) {
                renderMathInElement(document.body, {
                    delimiters: [
                        { left: '$$', right: '$$', display: true },
                        { left: '$', right: '$', display: false }
                    ],
                    throwOnError: false
                });
            }
        }

        // مسودة الرسم المطورة بالكامل
        let canvas, ctx;
        let isDrawing = false;
        let currentTool = 'pen';

        function initScratchCanvas() {
            canvas = document.getElementById('scratchCanvas');
            ctx = canvas.getContext('2d');

            canvas.addEventListener('pointerdown', handlePointerDown);
            canvas.addEventListener('pointermove', handlePointerMove);
            canvas.addEventListener('pointerup', handlePointerUp);
            canvas.addEventListener('pointercancel', handlePointerUp);

            window.addEventListener('resize', resizeScratchCanvas);
        }

        function openScratchpad() {
            const modal = document.getElementById('scratchpadModal');
            modal.style.display = 'flex';
            setTimeout(resizeScratchCanvas, 60);
        }

        function closeScratchpad() {
            document.getElementById('scratchpadModal').style.display = 'none';
        }

        function resizeScratchCanvas() {
            if (!canvas) canvas = document.getElementById('scratchCanvas');
            const container = canvas.parentElement;
            if (!container) return;

            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = canvas.width;
            tempCanvas.height = canvas.height;
            const tempCtx = tempCanvas.getContext('2d');
            if (canvas.width > 0 && canvas.height > 0) {
                tempCtx.drawImage(canvas, 0, 0);
            }

            canvas.width = container.clientWidth;
            canvas.height = container.clientHeight - 90;

            if (tempCanvas.width > 0 && tempCanvas.height > 0) {
                ctx.drawImage(tempCanvas, 0, 0);
            }
        }

        function getPos(e) {
            const rect = canvas.getBoundingClientRect();
            return {
                x: e.clientX - rect.left,
                y: e.clientY - rect.top
            };
        }

        function handlePointerDown(e) {
            isDrawing = true;
            try {
                canvas.setPointerCapture(e.pointerId);
            } catch(err){}
            
            const pos = getPos(e);
            ctx.beginPath();
            ctx.moveTo(pos.x, pos.y);

            if (currentTool === 'pen') {
                ctx.globalCompositeOperation = 'source-over';
                ctx.fillStyle = '#512da8';
                ctx.beginPath();
                ctx.arc(pos.x, pos.y, 1.5, 0, Math.PI * 2);
                ctx.fill();
            } else {
                ctx.globalCompositeOperation = 'destination-out';
                ctx.beginPath();
                ctx.arc(pos.x, pos.y, 13, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function handlePointerMove(e) {
            if (!isDrawing) return;
            const pos = getPos(e);

            if (currentTool === 'pen') {
                ctx.globalCompositeOperation = 'source-over';
                ctx.strokeStyle = '#512da8';
                ctx.lineWidth = 3;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
            } else {
                ctx.globalCompositeOperation = 'destination-out';
                ctx.lineWidth = 26;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
            }

            ctx.lineTo(pos.x, pos.y);
            ctx.stroke();
        }

        function handlePointerUp(e) {
            if (!isDrawing) return;
            isDrawing = false;
            try {
                canvas.releasePointerCapture(e.pointerId);
            } catch(err){}
            ctx.beginPath();
        }

        function setDrawTool(t) {
            currentTool = t;
            document.getElementById('penToolBtn').className = `tool-chip ${t === 'pen' ? 'active' : ''}`;
            document.getElementById('eraserToolBtn').className = `tool-chip ${t === 'eraser' ? 'active' : ''}`;
        }

        function clearScratchCanvas() {
            if (ctx && canvas) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
            }
        }
    </script>
</body>
</html>
